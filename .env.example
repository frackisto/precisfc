# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer le fichier .env (il est ignoré par git).

# --- Django -----------------------------------------------------------------------
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production : https://www.exemple.ci,https://exemple.ci
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production : chemin non devinable, ex. gestion-interne-7f3k/
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO
# Destinataires des alertes d'erreur (séparés par des virgules)
DJANGO_ADMINS=

# --- Base de données (MariaDB) -----------------------------------------------------
# Local WAMP : MariaDB écoute sur le port 3307 (MySQL sur 3306).
# LWS : mysql://compte_precisfc:motdepasse@localhost:3306/compte_precisfc
# (caractères spéciaux du mot de passe à encoder : @ -> %40, : -> %3A, / -> %2F)
DATABASE_URL=mysql://precisfc:mot_de_passe@127.0.0.1:3307/precisfc
TEST_DATABASE_NAME=test_precisfc
DB_CONN_MAX_AGE=60

# --- Cache et tâches -------------------------------------------------------------
# cPanel : cache en base. VPS : redis://127.0.0.1:6379/1
CACHE_URL=dbcache://django_cache
# cPanel : True (exécution immédiate). VPS avec worker : False + CELERY_BROKER_URL=redis://…
CELERY_TASK_ALWAYS_EAGER=True

# --- E-mails ----------------------------------------------------------------------
# Local : affichage dans la console. LWS (boîte créée dans cPanel) :
# EMAIL_URL=smtp+ssl://contact%40domaine.ci:motdepasse@mail.domaine.ci:465
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Precis FC <no-reply@localhost>

# --- Fichiers ---------------------------------------------------------------------
# Par défaut dans le dossier du projet. LWS :
# STATIC_ROOT=/home/compte/public_html/static
# MEDIA_ROOT=/home/compte/public_html/media
# PRIVATE_MEDIA_ROOT=/home/compte/precisfc_private
# LOG_DIR=/home/compte/precisfc/logs
MAX_UPLOAD_SIZE_MB=8

# --- Production uniquement -------------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_TRUST_X_FORWARDED_PROTO=False
# Activer seulement après validation du HTTPS (ex. 31536000 = 1 an) :
# DJANGO_SECURE_HSTS_SECONDS=0
