# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer le fichier .env (il est ignoré par git).

# --- Django -----------------------------------------------------------------------
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production : https://www.exemple.ci,https://exemple.ci
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production : chemin non devinable, ex. gestion-interne-7f3k/
DJANGO_ADMIN_URL=admin/

# --- Base de données (MariaDB) -----------------------------------------------------
# Local WAMP : MariaDB écoute sur le port 3307 (MySQL sur 3306).
# LWS : mysql://compte_precisfc:motdepasse@localhost:3306/compte_precisfc
DATABASE_URL=mysql://precisfc:mot_de_passe@127.0.0.1:3307/precisfc
TEST_DATABASE_NAME=test_precisfc
DB_CONN_MAX_AGE=60

# --- Fichiers (facultatif, valeurs par défaut dans le dossier du projet) ---------
# STATIC_ROOT=/home/compte/public_html/static
# MEDIA_ROOT=/home/compte/public_html/media
# PRIVATE_MEDIA_ROOT=/home/compte/precisfc_private

# --- Production uniquement -------------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_TRUST_X_FORWARDED_PROTO=False
# Activer seulement après validation du HTTPS (ex. 31536000 = 1 an) :
# DJANGO_SECURE_HSTS_SECONDS=0
